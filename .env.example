# === Wallet ===
# Cara 1: langsung private key (kurang aman)
PRIVATE_KEY=

# Cara 2: password untuk keystore (lebih aman, direkomendasikan)
WALLET_PASSWORD=

# === Network ===
# bsc-testnet | bsc (mainnet)
NETWORK=bsc-testnet

# RPC (opsional, default pakai public)
RPC_URL=

# === Agent Identity ===
AGENT_NAME=SnipBot-BNB
AGENT_DESCRIPTION=Fully autonomous meme coin sniper & portfolio manager on BNB Chain. Targets new listings on four.meme and Flap with anti-rug filters (LP burn, holder concentration, volume).
AGENT_ENDPOINT=https://your-agent-domain.com/status

# === Risk ===
MAX_TRADE_PCT=0.04          # 4% of wallet per trade (range 3-5%)
MAX_TOTAL_EXPOSURE=0.25     # max 25% wallet in meme positions
MIN_VOLUME_USD=8000
MAX_VOLUME_USD=15000
MIN_LIQUIDITY_USD=3000

# === Trading ===
SLIPPAGE_BPS=300            # 3%
GAS_PRICE_GWEI=3

# === Optional LLM advisory (read-only; never enables trading) ===
LLM_API_KEY=
LLM_MODEL=
# Optional OpenAI-compatible HTTPS endpoint. Never paste secrets into Git.
LLM_BASE_URL=https://api.openai.com/v1/chat/completions

# === Persistent read-only PumpFun monitor state ===
PUMPFUN_DB_PATH=data/pumpfun_monitor.sqlite3
