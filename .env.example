# === Wallet ===
# Cara 1: langsung private key (kurang aman)
PRIVATE_KEY=

# Cara 2: password untuk keystore (lebih aman, direkomendasikan)
WALLET_PASSWORD=

# === Network ===
# bsc-testnet | bsc (mainnet)
NETWORK=bsc-testnet

# RPC (opsional, default pakai public)
RPC_URL=

# === Agent Identity ===
AGENT_NAME=SnipBot-BNB
AGENT_DESCRIPTION=Fully autonomous meme coin sniper & portfolio manager on BNB Chain. Targets new listings on four.meme and Flap with anti-rug filters (LP burn, holder concentration, volume).
AGENT_ENDPOINT=https://your-agent-domain.com/status

# === Risk ===
MAX_TRADE_PCT=0.04          # 4% of wallet per trade (range 3-5%)
MAX_TOTAL_EXPOSURE=0.25     # max 25% wallet in meme positions
MIN_VOLUME_USD=8000
MAX_VOLUME_USD=15000
MIN_LIQUIDITY_USD=3000

# === Trading ===
SLIPPAGE_BPS=300            # 3%
GAS_PRICE_GWEI=3

# === Optional LLM advisory (read-only; never enables trading) ===
LLM_API_KEY=
LLM_MODEL=
# Optional OpenAI-compatible HTTPS endpoint. Never paste secrets into Git.
LLM_BASE_URL=https://api.openai.com/v1/chat/completions

# === PumpFun FOMO Radar (read-only data stream) ===
# Leave blank in this example file. Set the real value only in your local shell.
# WARNING: if this key was issued together with a PumpPortal wallet, treat it as a trading-capable secret.
PUMPPORTAL_API_KEY=

# === Persistent read-only PumpFun monitor state ===
PUMPFUN_DB_PATH=data/pumpfun_monitor.sqlite3

# === Optional read-only Solana RPC mint checks (HTTPS endpoint) ===
SOLANA_RPC_URL=

# === PumpFun read-only worker operation ===
# false for a bounded local session; true for an always-on background worker.
PUMPFUN_RUN_FOREVER=false
PUMPFUN_SCAN_SECONDS=60

# === Optional Telegram alerts (configure only in private runtime environment) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === LLM Sniper + Bubble Maps + micro-bankroll paper mode ===
# LLM scoring reuses LLM_API_KEY / LLM_MODEL above. It can only veto or
# approve PAPER candidates; it never enables live trading.
# Bubble Maps holder checks reuse SOLANA_RPC_URL above (read-only).
MICRO_BANKROLL_USD=5
MICRO_POSITION_USD=1
MICRO_TARGET_USD=1500

# === Live executor (PR #5) — leave BOTH unset unless deliberately going live ===
# SNIPER_LIVE_ENABLED=true
# SNIPER_LIVE_CONFIRM=I_UNDERSTAND_LIVE_TRADING
# Keypair file lives OUTSIDE the repo (Solana CLI JSON, 64 bytes). Never commit it.
SOLANA_KEYPAIR_PATH=
